<?svml using="@hypit/recipe@1"?>
<sheet version="1">
  film.main { background: #efdcd6; }

  visual.card { border-width: 3; border-color: #cfcbd3; radius: 14; }

  text.hook { size: 86; line-height: 1.04; weight: 700; }
  text.eyebrow { size: 36; line-height: 1.2; tracking: 1.6; weight: 700; }
  text.title { size: 92; line-height: 1.05; weight: 700; }
  text.sub { size: 44; line-height: 1.3; weight: 400; }
  text.key { size: 56; line-height: 1.08; weight: 700; }
  text.val { size: 36; line-height: 1.4; weight: 400; }
  text.sum { size: 40; line-height: 1.2; weight: 700; }
  text.label { size: 40; line-height: 1.2; tracking: 4.8; weight: 700; }
  text.chip { size: 72; line-height: 2.4; word-spacing: 40; weight: 700; }
  text.fact { size: 48; line-height: 1.4; weight: 400; }
  text.factbold { size: 48; line-height: 1.4; weight: 700; }
  text.coltitle { size: 88; line-height: 1.1; weight: 700; }
  text.colname { size: 38; line-height: 1.2; weight: 700; }
  text.endname { size: 76; line-height: 1.15; weight: 700; }
  text.endscript { size: 130; line-height: 1; weight: 400; }
  text.endkebaya { size: 52; line-height: 1.3; weight: 400; }
  text.endtag { size: 36; line-height: 1.6; weight: 700; }
  text.endbadge { size: 32; line-height: 1.7; weight: 400; }
  text.cta { size: 44; line-height: 1.2; weight: 700; }
</sheet>
